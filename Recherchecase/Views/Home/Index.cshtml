@{ ViewData["Title"] = "Start"; }
<section class="hero-panel">
    <div class="hero-copy">
        <div class="eyebrow"><span class="status-dot"></span> Recherche · Zaakbeheer</div>
        <h1>Goed onderzoek begint<br />met <span>overzicht.</span></h1>
        <p>Leg zaken zorgvuldig vast en vind bestaande dossiers snel terug.</p>
        <div class="hero-actions">
            <a asp-controller="Zaak" asp-action="Index" class="btn btn-primary btn-lg">Naar zaakoverzicht <span aria-hidden="true">→</span></a>
            <a asp-controller="Zaak" asp-action="MaakZaakAan" class="btn btn-outline-light btn-lg">Nieuwe zaak</a>
        </div>
    </div>
    <div class="hero-art" aria-hidden="true"><div class="folder-icon">⌕</div><div class="art-label">DOSSIER<br /><strong>01 / RC</strong></div><div class="art-line"></div></div>
</section>
<section class="welcome-grid">
    <article class="welcome-card"><span class="card-index">01</span><h2>Leg vast</h2><p>Maak een nieuw dossier aan met een duidelijke titel en eerste notitie.</p><a asp-controller="Zaak" asp-action="MaakZaakAan">Zaak registreren <span>→</span></a></article>
    <article class="welcome-card"><span class="card-index">02</span><h2>Bekijk</h2><p>Zoek een dossier op met het zaaknummer en bekijk de actuele gegevens.</p><a asp-controller="Zaak" asp-action="Index">Zoek een zaak <span>→</span></a></article>
    <article class="welcome-card"><span class="card-index">03</span><h2>Werk bij</h2><p>Pas de titel en notitie aan wanneer er nieuwe informatie beschikbaar is.</p><a asp-controller="Zaak" asp-action="Index">Naar zaakoverzicht <span>→</span></a></article>
</section>
