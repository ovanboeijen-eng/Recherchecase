
<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Recherche Caseworker</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand fw-bold"
               asp-controller="Zaak" asp-action="Index">
                <span class="text-info">RC</span> Recherche Caseworker
            </a>

            <div class="navbar-nav ms-auto">
                <a class="nav-link"
                   asp-controller="Zaak" asp-action="Index">
                    Zaken
                </a>
                <a class="nav-link"
                   asp-controller="Zaak" asp-action="MaakZaakAan">
                    Nieuwe zaak
                </a>
            </div>
        </div>
    </nav>

    <main class="container py-5">
        @RenderBody()
    </main>

    <footer class="border-top py-3 mt-5">
        <div class="container text-muted small">
            Recherche Caseworker · Zaakbeheer
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
