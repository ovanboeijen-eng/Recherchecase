@model Recherchecase.ViewModels.ZaakViewModel

@{
    ViewData["Title"] = "Nieuwe zaak";
}

<div class="mb-4">
    <p class="text-uppercase text-secondary small mb-1">Zaakbeheer</p>
    <h1 class="fw-bold">Nieuwe zaak aanmaken</h1>
    <p class="text-secondary">
        Registreer de basisgegevens van een nieuwe recherchezaak.
    </p>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form asp-action="MaakZaakAan" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Titel" class="form-label fw-semibold">
                    Zaaktitel
                </label>
                <input asp-for="Titel"
                       class="form-control"
                       placeholder="Bijvoorbeeld: Diefstal bij winkel" />
                <span asp-validation-for="Titel"
                      class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Notitie" class="form-label fw-semibold">
                    Notitie
                </label>
                <textarea asp-for="Notitie"
                          class="form-control"
                          rows="5"
                          placeholder="Beschrijf de eerste informatie over de zaak..."></textarea>
                <span asp-validation-for="Notitie"
                      class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    Zaak opslaan
                </button>
                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Annuleren
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
