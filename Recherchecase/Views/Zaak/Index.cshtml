@model IReadOnlyList<Recherchecase.ViewModels.ZaakViewModel>

@{
    ViewData["Title"] = "Zaakoverzicht";
}

<div class="page-heading">
    <div>
        <div class="eyebrow"><span class="status-dot"></span> Dossierbeheer</div>
        <h1>Zaakoverzicht</h1>
        <p>Bekijk en open de geregistreerde zaken.</p>
    </div>
    <a asp-action="MaakZaakAan" class="btn btn-primary">＋ Nieuwe zaak</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success border-0">@success</div>
}

<div class="search-panel overview-search">
    <div class="search-symbol" aria-hidden="true">⌕</div>
    <div class="search-content">
        <h2>Zoek op zaaknummer</h2>
        <p>Vul een zaaknummer in om direct naar dat dossier te gaan.</p>
        <form asp-action="Index" method="get" class="search-form">
            <label for="zaakId" class="visually-hidden">Zaaknummer</label>
            <input id="zaakId" name="zaakId" type="number" min="1" class="form-control" placeholder="Bijvoorbeeld 1042" required />
            <button type="submit" class="btn btn-primary">Dossier openen <span aria-hidden="true">→</span></button>
        </form>
        @if (ViewBag.SearchError is string searchError)
        {
            <div class="text-danger mt-2">@searchError</div>
        }
    </div>
</div>

@if (ViewBag.ListError is string listError)
{
    <div class="alert alert-danger mt-4">@listError</div>
}
else
{
    <section class="overview-list" aria-labelledby="zakenlijst-titel">
        <div class="overview-list-heading">
            <div>
                <h2 id="zakenlijst-titel">Alle zaken</h2>
                <p>De nieuwste zaken staan bovenaan.</p>
            </div>
            <span class="overview-count">@Model.Count @(Model.Count == 1 ? "zaak" : "zaken")</span>
        </div>

        @if (Model.Count == 0)
        {
            <div class="overview-empty">
                <span class="overview-empty-icon" aria-hidden="true">▤</span>
                <h3>Nog geen zaken</h3>
                <p>Maak een nieuwe zaak aan; die verschijnt daarna hier in het overzicht.</p>
                <a asp-action="MaakZaakAan" class="btn btn-primary">＋ Nieuwe zaak</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table overview-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Zaaknummer</th>
                            <th scope="col">Titel</th>
                            <th scope="col">Aangemaakt op</th>
                            <th scope="col"><span class="visually-hidden">Actie</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var zaak in Model)
                        {
                            <tr>
                                <td><span class="overview-case-number">#@zaak.Nummer</span></td>
                                <td>
                                    <span class="overview-case-title">@zaak.Titel</span>
                                    @if (!string.IsNullOrWhiteSpace(zaak.Notitie))
                                    {
                                        <span class="overview-case-note">@zaak.Notitie</span>
                                    }
                                </td>
                                <td class="overview-date">@DateTime.SpecifyKind(zaak.AangemaaktOp, DateTimeKind.Utc).ToLocalTime().ToString("dd-MM-yyyy HH:mm")</td>
                                <td class="text-end">
                                    <a asp-action="BekijkZaak" asp-route-zaakId="@zaak.Nummer" class="overview-open-link">Open zaak <span aria-hidden="true">→</span></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}
